---
/**
 * Rendu d'un guide ou d'une page outil défini dans `src/content/`. Ordre (RECETTE §9.3, §21) :
 * H1 et chapeau ; page outil : l'outil, puis le bloc citable replié ; guide : le bloc citable, puis
 * le mini-simulateur, puis le corps. FAQ, pages associées, sources et encart auteur viennent du
 * PageLayout, avec la FAQ affichée et balisée depuis la même liste (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import PrisCalc from './calc/PrisCalc';
import ApparatCalc from './calc/ApparatCalc';
import ElbilCalc from './calc/ElbilCalc';
import HistorikCalc from './calc/HistorikCalc';
import NatCalc from './calc/NatCalc';
import { verktygProps } from '../lib/verktyg';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const H = helpers(lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
/** Outil de référence de chaque groupe : cible par défaut du bouton des mini-simulateurs. */
const cible = page.miniHref ?? 'home';
const miniHref = route(cible, lang);
const tp = verktygProps(page.toolProps);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-6" />
        <div data-outil>
          {page.tool === 'pris' && <PrisCalc client:load lang={lang} methodHref={methodHref} mode={tp.mode as 'idag'} nat={tp.nat} fall={tp.fall} zon={tp.zon} skatt={tp.skatt} />}
          {page.tool === 'apparat' && <ApparatCalc client:load lang={lang} methodHref={methodHref} apparat={tp.apparat} nat={tp.nat} fall={tp.fall} zon={tp.zon} skatt={tp.skatt} />}
          {page.tool === 'elbil' && <ElbilCalc client:load lang={lang} methodHref={methodHref} nat={tp.nat} fall={tp.fall} zon={tp.zon} skatt={tp.skatt} />}
          {page.tool === 'historik' && <HistorikCalc client:load lang={lang} methodHref={methodHref} mode="historik" zon={tp.zon} />}
          {page.tool === 'avtal' && <HistorikCalc client:load lang={lang} methodHref={methodHref} mode="avtal" zon={tp.zon} />}
          {page.tool === 'nat' && <NatCalc client:load lang={lang} methodHref={methodHref} nat={tp.nat} fall={tp.fall} />}
        </div>
      </>
    ) : (
      <>
        <p class="mb-6 text-navy-800" set:html={resume} />
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} />}
      </>
    )}
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
    </div>
  </article>
</PageLayout>
