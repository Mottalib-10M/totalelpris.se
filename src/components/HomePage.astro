---
/**
 * Accueil d'une langue (page pilier, RECETTE §5). Trame propre au sujet : réponse chiffrée, calculateur
 * du prix final, encadré « pourquoi pas de spot », tableau par elområde tiré de SCB, texte, puis un
 * sommaire par famille de pages (zones, villes, réseaux, appareils, guides). Textes : content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PrisCalc from './calc/PrisCalc';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { navCategories } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { STANDARD_NAT } from '../lib/verktyg';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
import { displayDate } from '../lib/format';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['lse', 'skvEl', 'skvSankt2026', 'skvMoms', 'eiNat', 'scbElpriser', 'svkElomraden', 'natomraden', 'embElrakning', 'entsoe'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const sv = lang === 'sv';
const groups = navCategories(lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-700">{sv ? 'Energiskatt och nätavgifter för' : 'Energy tax and grid fees for'} {P.year}, {sv ? 'kontrollerade' : 'checked'} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, LANG_TAGS[lang])}</time> · <a href={route('method', lang)} class="underline hover:text-navy-900">{sv ? 'Metod och källor' : 'Method and sources'}</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">{sv ? 'Om oss' : 'About'}</a></p>
  </header>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={1} class="mb-5" />
  <div data-outil>
    <PrisCalc client:load lang={lang} methodHref={route('method', lang)} nat={STANDARD_NAT} fall={0} zon={2} />
  </div>
  <div class="prose prose-slate mt-10 max-w-none">
    <Fragment set:html={x.body(H)} />
  </div>
  <section class="mt-12" data-chrome>
    <h2 class="mb-4 text-2xl font-bold text-navy-900">{sv ? 'Alla sidor' : 'All pages'}</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <div><h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-navy-700">{g.label}</h3>
          <ul class="space-y-1 text-navy-800">{g.links.map((l) => <li><a class="underline decoration-navy-300 underline-offset-2 hover:text-accent-700" href={l.href}>{l.label}</a></li>)}</ul></div>
      ))}
    </div>
  </section>
</PageLayout>
